# Generate a value with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep .env.home private (chmod 600); paste this key into MemeDrop > Fetch Service.
MEMEDROP_API_KEY=

# Required when Compose reads the shared Caddy definition; Caddy is not started.
MEMEDROP_DOMAIN=homeserver.tail4fc390.ts.net
