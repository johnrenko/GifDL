FROM ghcr.io/imputnet/cobalt:11@sha256:63186dd68afd57ce3bb1f62cc4c139f5fa95b9c3e87a3cf5c6e4c7a570523f62

USER root

RUN apk add --no-cache python3 tini

COPY --chown=node:node Backend/server.py /memedrop/server.py
COPY --chown=node:node deploy/render-entrypoint.sh /memedrop/render-entrypoint.sh

RUN chmod +x /memedrop/render-entrypoint.sh

USER node

ENV API_LISTEN_ADDRESS=127.0.0.1
ENV API_PORT=9000
ENV API_URL=http://127.0.0.1:9000/
ENV MEMEDROP_COBALT_API_URL=http://127.0.0.1:9000/
ENV MEMEDROP_FETCH_HOST=0.0.0.0
ENV PORT=10000

EXPOSE 10000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/memedrop/render-entrypoint.sh"]
