MEMEDROP_DOMAIN=api.example.com

# Internal cobalt connectivity for the Python bridge.
MEMEDROP_COBALT_API_URL=http://cobalt:9000/

# Leave blank to proxy only internal cobalt URLs.
# Set this to a public cobalt URL only if you expose cobalt separately.
MEMEDROP_COBALT_PUBLIC_URL=

MEMEDROP_COBALT_TIMEOUT=30
MEMEDROP_COBALT_DOWNLOAD_MODE=auto
MEMEDROP_COBALT_FILENAME_STYLE=basic
MEMEDROP_COBALT_ALWAYS_PROXY=false
MEMEDROP_COBALT_VIDEO_QUALITY=
MEMEDROP_COBALT_AUDIO_FORMAT=
MEMEDROP_COBALT_API_KEY=
MEMEDROP_COBALT_AUTHORIZATION=

# Keep cobalt private by default. The internal API URL is enough because
# MemeDrop proxies tunnel downloads through /proxy on the public backend.
COBALT_API_URL=http://cobalt:9000/
COBALT_API_AUTH_REQUIRED=0
COBALT_CORS_WILDCARD=0
COBALT_CORS_URL=
COBALT_API_KEY_URL=
COBALT_COOKIE_PATH=
COBALT_JWT_SECRET=
COBALT_TURNSTILE_SITEKEY=
COBALT_TURNSTILE_SECRET=
COBALT_RATELIMIT_WINDOW=60
COBALT_RATELIMIT_MAX=20
COBALT_TUNNEL_RATELIMIT_WINDOW=60
COBALT_TUNNEL_RATELIMIT_MAX=40
